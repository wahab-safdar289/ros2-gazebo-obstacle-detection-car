<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- One wheel joint: velocity command in, position and velocity state out -->
  <xacro:macro name="wheel_joint_interface" params="name">
    <joint name="${name}_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-20.0</param>
        <param name="max">20.0</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="car_ros2_control">

    <!-- ================= ros2_control hardware description ================= -->
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <xacro:wheel_joint_interface name="front_left"/>
      <xacro:wheel_joint_interface name="front_right"/>
      <xacro:wheel_joint_interface name="rear_left"/>
      <xacro:wheel_joint_interface name="rear_right"/>
    </ros2_control>

    <!-- ================= Gazebo plugin: starts controller_manager inside Gazebo ================= -->
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find car_description)/config/controllers.yaml</parameters>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
