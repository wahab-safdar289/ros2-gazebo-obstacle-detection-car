<?xml version="1.0"?>
<sdf version="1.9">
  <world name="obstacle_world">

    <!-- ================= Physics ================= -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- ================= System plugins ================= -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <!-- Required: without this, the lidar and camera publish nothing -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- ================= Light ================= -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -1.0</direction>
    </light>

    <!-- ================= Ground ================= -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>40 40</size></plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>40 40</size></plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= Perimeter walls (20 m x 20 m arena) ================= -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 10 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -10 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>20.4 0.2 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>20.4 0.2 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>10 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 20.4 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 20.4 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 20.4 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 20.4 1.0</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Boxes ================= -->
    <model name="box_1">
      <static>true</static>
      <pose>3 1.5 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <static>true</static>
      <pose>5 -1 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.4 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.4 0.6</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rotated box: tests non-axis-aligned surfaces -->
    <model name="box_rotated">
      <static>true</static>
      <pose>0 5 0.25 0 0 0.785</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8 0.8 0.5</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8 0.8 0.5</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box_big">
      <static>true</static>
      <pose>-6 -6 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5 0.8 0.8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5 0.8 0.8</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Cylinders ================= -->
    <model name="cylinder_1">
      <static>true</static>
      <pose>4 3.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.3 1</ambient><diffuse>0.2 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="cylinder_2">
      <static>true</static>
      <pose>7 2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.3</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.2 0.7 0.3 1</ambient><diffuse>0.2 0.7 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Slalom row (2 m spacing, alternating sides) ================= -->
    <model name="slalom_1">
      <static>true</static>
      <pose>1 -4 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="slalom_2">
      <static>true</static>
      <pose>3 -6 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="slalom_3">
      <static>true</static>
      <pose>5 -4 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="slalom_4">
      <static>true</static>
      <pose>7 -6 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.2</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Thin pillars ================= -->
    <model name="pillar_1">
      <static>true</static>
      <pose>-3 3 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 1.0</size></box></geometry>
          <material><ambient>0.4 0.4 0.5 1</ambient><diffuse>0.4 0.4 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>-4.5 -2 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 1.0</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 1.0</size></box></geometry>
          <material><ambient>0.4 0.4 0.5 1</ambient><diffuse>0.4 0.4 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Narrow gate: 0.8 m gap at x = -6, y from 4.4 to 5.2 ================= -->
    <model name="gate_a">
      <static>true</static>
      <pose>-6 7.1 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 3.8 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 3.8 0.6</size></box></geometry>
          <material><ambient>0.6 0.3 0.7 1</ambient><diffuse>0.6 0.3 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="gate_b">
      <static>true</static>
      <pose>-6 2.7 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 3.4 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 3.4 0.6</size></box></geometry>
          <material><ambient>0.6 0.3 0.7 1</ambient><diffuse>0.6 0.3 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Dead-end "U" pocket (opens toward -x), centered near (7.8, 6.5) ================= -->
    <model name="dead_end_back">
      <static>true</static>
      <pose>8.8 6.5 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.2 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.2 0.6</size></box></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dead_end_left">
      <static>true</static>
      <pose>7.8 8.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.2 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.2 0.6</size></box></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="dead_end_right">
      <static>true</static>
      <pose>7.8 5.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0 0.2 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.2 0.6</size></box></geometry>
          <material><ambient>0.2 0.5 0.8 1</ambient><diffuse>0.2 0.5 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ================= Low barrier in the south-west ================= -->
    <model name="barrier_sw">
      <static>true</static>
      <pose>-8 -3 0.3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2 3.0 0.6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 3.0 0.6</size></box></geometry>
          <material><ambient>0.4 0.4 0.5 1</ambient><diffuse>0.4 0.4 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
